{
	"schemaVersion": 1,
	"id": "sauced",
	"version": "${version}",
	"name": "Sauced",
	"description": "Mmmm... burger...",
	"authors": [ "SSBlur", "TheEnderCore" ],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/sauced/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [ "com.ssblur.sauced.SaucedFabric" ],
		"client": [ "com.ssblur.sauced.SaucedFabric" ],
		"jei_mod_plugin": [
			{
				"value": "com.ssblur.sauced.integration.jei.SaucedJEIIntegration",
				"adapter": "kotlin"
			}
		],
		"emi": [
			{
				"value": "com.ssblur.sauced.integration.emi.SaucedEMIIntegration",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"sauced.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": ">=${minecraft_version}",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"unfocused": ">=${unfocused_version}"
	},
	"suggests": {}
}